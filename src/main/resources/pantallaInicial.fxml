<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="700.0" spacing="15.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vista.PantallaInicialController">
   <children>
      <TableView fx:id="tablaPrincipal" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="nombreTable" prefWidth="150.0" text="Nombre" />
          <TableColumn fx:id="especieTable" prefWidth="150.0" text="Especie" />
          <TableColumn fx:id="edadTable" prefWidth="100.0" text="Edad" />
          <TableColumn fx:id="propietarioTable" prefWidth="200.0" text="Propietario" />
        </columns>
      </TableView>
      
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#abrirVentanaCrear" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Crear Paciente" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>